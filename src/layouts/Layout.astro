---
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Art portfolio' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,250;0,9..40,300;0,9..40,350;0,9..40,400;0,9..40,500;0,9..40,550;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
    />
    <style is:inline>
      html:not(.is-ready) {
        background: #ffffff;
      }

      html:not(.is-ready)[data-theme='dark'] {
        background: #1f1d1b;
      }

      #page-loader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-family: 'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
          sans-serif;
        transition: opacity 0.35s ease, visibility 0.35s ease;
      }

      html:not(.is-ready) #page-loader {
        opacity: 1;
        visibility: visible;
      }

      html.is-ready #page-loader {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      html:not(.is-ready) .page-content {
        opacity: 0;
        pointer-events: none;
      }

      html.is-ready .page-content {
        opacity: 1;
        transition: opacity 0.35s ease;
      }

      .page-loader__spinner {
        position: relative;
        width: 48px;
        height: 48px;
      }

      .page-loader__spinner-svg {
        display: block;
        width: 100%;
        height: 100%;
      }

      .page-loader__spinner-rotor {
        position: absolute;
        inset: 0;
        -webkit-animation: page-loader-spin 0.85s linear infinite;
        animation: page-loader-spin 0.85s linear infinite;
      }

      .page-loader__spinner-track,
      .page-loader__spinner-arc {
        fill: none;
        stroke-width: 3;
      }

      .page-loader__spinner-track {
        stroke: #e4e4e4;
      }

      html[data-theme='dark'] .page-loader__spinner-track {
        stroke: #45403a;
      }

      .page-loader__spinner-arc {
        stroke: #1a1a1a;
        stroke-linecap: round;
        stroke-dasharray: 36, 77;
      }

      html[data-theme='dark'] .page-loader__spinner-arc {
        stroke: #f0ece8;
      }

      @-webkit-keyframes page-loader-spin {
        to {
          -webkit-transform: rotate(360deg);
          transform: rotate(360deg);
        }
      }

      @keyframes page-loader-spin {
        to {
          -webkit-transform: rotate(360deg);
          transform: rotate(360deg);
        }
      }
    </style>
    <script is:inline>
      (function () {
        try {
          var k = 'theme';
          var stored = localStorage.getItem(k);
          var dark =
            stored === 'dark' ||
            (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body aria-busy="true">
    <div id="page-loader" class="page-loader" role="status" aria-live="polite" aria-label="Loading">
      <div class="page-loader__inner">
        <p class="page-loader__title">{site.siteTitle}</p>
        <p class="page-loader__artist">{site.artistName}</p>
        <div class="page-loader__spinner" aria-hidden="true">
          <svg class="page-loader__spinner-svg" viewBox="0 0 48 48" width="48" height="48">
            <circle class="page-loader__spinner-track" cx="24" cy="24" r="18"></circle>
          </svg>
          <div class="page-loader__spinner-rotor">
            <svg class="page-loader__spinner-svg" viewBox="0 0 48 48" width="48" height="48">
              <circle class="page-loader__spinner-arc" cx="24" cy="24" r="18"></circle>
            </svg>
          </div>
        </div>
      </div>
    </div>
    <div class="page-content">
      <slot />
    </div>
    <script is:inline>
      (function () {
        var IMAGE_TIMEOUT_MS = 15000;

        function decodeImg(img) {
          if (img.decode) {
            return img.decode().catch(function () {});
          }
          return Promise.resolve();
        }

        function waitForImg(img) {
          if (img.complete && img.naturalWidth > 0) {
            return decodeImg(img);
          }

          img.loading = 'eager';

          return new Promise(function (resolve) {
            var settled = false;

            function done() {
              if (settled) return;
              settled = true;
              decodeImg(img).then(resolve);
            }

            img.addEventListener('load', done, { once: true });
            img.addEventListener('error', done, { once: true });
            setTimeout(done, IMAGE_TIMEOUT_MS);
          });
        }

        function reveal() {
          document.documentElement.classList.add('is-ready');
          document.body.removeAttribute('aria-busy');

          var loader = document.getElementById('page-loader');
          if (!loader) return;

          loader.addEventListener('transitionend', function onEnd(e) {
            if (e.propertyName !== 'opacity') return;
            loader.setAttribute('hidden', '');
            loader.removeEventListener('transitionend', onEnd);
          });
        }

        function whenImagesReady() {
          var imgs = document.querySelectorAll('.gallery img');
          if (!imgs.length) {
            imgs = document.querySelectorAll('img');
          }

          if (!imgs.length) {
            reveal();
            return;
          }

          Promise.all(Array.prototype.map.call(imgs, waitForImg)).then(reveal);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', whenImagesReady);
        } else {
          whenImagesReady();
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --font-body: 'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-display: var(--font-body);
    --max-width: 1320px;
    --header-height: 68px;
    --color-text: #1a1a1a;
    --color-text-secondary: #555;
    --color-text-muted: #888;
    --color-border: #e4e4e4;
    --color-bg: #ffffff;
    --color-surface: #f0f0ee;
    --color-header-bg: rgba(255, 255, 255, 0.72);
    --artwork-caption-fade: rgba(0, 0, 0, 0.52);
    --artwork-caption-fade-end: rgba(0, 0, 0, 0.88);
    --artwork-caption-text: #ffffff;
    --shadow-artwork: 0 2px 14px rgba(0, 0, 0, 0.07);
    --shadow-artwork-hover: 0 14px 36px rgba(0, 0, 0, 0.18), 0 4px 14px rgba(0, 0, 0, 0.1);
    --shadow-artwork-canvas:
      -3px 4px 5px -1px rgba(0, 0, 0, 0.26), -6px 8px 12px -2px rgba(0, 0, 0, 0.22),
      -9px 12px 18px -4px rgba(0, 0, 0, 0.16);
    --shadow-artwork-canvas-hover:
      -5px 7px 12px -1px rgba(0, 0, 0, 0.38), -10px 14px 24px -2px rgba(0, 0, 0, 0.32),
      -16px 22px 36px -4px rgba(0, 0, 0, 0.26);
    --shadow-artwork-soft:
      0 2px 8px rgba(0, 0, 0, 0.1), 0 8px 20px rgba(0, 0, 0, 0.08),
      -2px 3px 10px rgba(0, 0, 0, 0.06);
    --shadow-artwork-soft-hover:
      0 10px 24px rgba(0, 0, 0, 0.16), 0 20px 44px rgba(0, 0, 0, 0.12),
      -4px 6px 20px rgba(0, 0, 0, 0.1);
  }

  html[data-theme='light'] {
    color-scheme: light;
  }

  html[data-theme='dark'] {
    color-scheme: dark;
    --color-text: #f0ece8;
    --color-text-secondary: #c4bdb4;
    --color-text-muted: #8a847c;
    --color-border: #45403a;
    --color-bg: #1f1d1b;
    --color-surface: #2c2926;
    --color-header-bg: rgba(31, 29, 27, 0.72);
    --artwork-caption-fade: rgba(0, 0, 0, 0.58);
    --artwork-caption-fade-end: rgba(0, 0, 0, 0.94);
    --artwork-caption-text: #f5f5f5;
    /* Depth only — no white hairline (avoids light-edge flash on hover) */
    --shadow-artwork: 0 4px 20px rgba(0, 0, 0, 0.55);
    --shadow-artwork-hover: 0 18px 52px rgba(0, 0, 0, 0.78), 0 6px 18px rgba(0, 0, 0, 0.55);
    --shadow-artwork-canvas:
      -4px 6px 14px -2px rgba(0, 0, 0, 0.55), -12px 16px 32px -8px rgba(0, 0, 0, 0.42);
    --shadow-artwork-canvas-hover:
      -6px 10px 22px -2px rgba(0, 0, 0, 0.72), -16px 24px 44px -8px rgba(0, 0, 0, 0.58);
    --shadow-artwork-soft:
      0 4px 16px rgba(0, 0, 0, 0.45), 0 10px 28px rgba(0, 0, 0, 0.32);
    --shadow-artwork-soft-hover:
      0 12px 32px rgba(0, 0, 0, 0.58), 0 24px 52px rgba(0, 0, 0, 0.45);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  img {
    max-width: 100%;
    display: block;
  }

  button {
    cursor: pointer;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .page-loader {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .page-loader[hidden] {
    display: none;
  }

  .page-loader__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 24px;
  }

  .page-loader__title {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .page-loader__artist {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.03em;
    margin-bottom: 8px;
  }

  .page-loader__spinner {
    position: relative;
    width: 48px;
    height: 48px;
  }

  @media (max-width: 640px) {
    html {
      font-size: 92.5%;
    }

    :root {
      --header-height: 58px;
    }
  }
</style>
