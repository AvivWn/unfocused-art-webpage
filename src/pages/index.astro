---
import Layout from '../layouts/Layout.astro';
import artworksRaw from '../data/artworks.json';
import site from '../data/site.json';
import { formatArtworkDate, getArtworkDateParts } from '../utils/formatArtworkDate';
import { buildGallerySections } from '../utils/buildGallerySections';
import {
  GALLERY_DISPLAY_PX_PER_GRID_UNIT,
  GALLERY_GRID_RESOLUTION,
  layoutGallerySection,
} from '../utils/galleryGridLayout';

type ArtworkEntry = (typeof artworksRaw)[number];

function isCanvasPainting(materials: ArtworkEntry['materials']): boolean {
  return typeof materials === 'string' && /\bcanvas\b/i.test(materials);
}

function isDigitalArtwork(materials: ArtworkEntry['materials']): boolean {
  return typeof materials === 'string' && materials.trim().toLowerCase() === 'digital';
}

function isCharcoalArtwork(materials: ArtworkEntry['materials']): boolean {
  return typeof materials === 'string' && materials.trim().toLowerCase() === 'charcoal';
}

const gallerySections = buildGallerySections(artworksRaw).map((section) => ({
  ...section,
  placed: layoutGallerySection(section.cards, GALLERY_GRID_RESOLUTION),
}));

/** Shared slug body for URL fragments (ASCII letters, digits, hyphens). */
function slugRawFromTitle(title: string, emptyFallback: string): string {
  const raw = title
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
  return raw || emptyFallback;
}

/** URL fragments like #acrylic-views-dimension-reduction (reserved words get a `section-` prefix). */
function slugifyFragmentFromTitle(title: string): string {
  const slug = slugRawFromTitle(title, 'section');
  const reserved = new Set(['top', 'about', 'works', 'lightbox']);
  return reserved.has(slug) ? `section-${slug}` : slug;
}

function uniqueGallerySectionFragmentIds(titles: string[]): string[] {
  const counts = new Map<string, number>();
  return titles.map((title) => {
    const base = slugifyFragmentFromTitle(title);
    const n = (counts.get(base) ?? 0) + 1;
    counts.set(base, n);
    return n === 1 ? base : `${base}-${n}`;
  });
}

const gallerySectionFragmentIds = uniqueGallerySectionFragmentIds(gallerySections.map((s) => s.title));

const takenArtworkFragmentIds = new Set<string>([
  'top',
  'about',
  'works',
  'lightbox',
  ...gallerySectionFragmentIds,
]);

/** Unique artwork #fragments: never collide with section ids or reserved routes. */
function uniqueArtworkFragmentIds(titles: string[], taken: Set<string>): string[] {
  const used = new Set(taken);
  return titles.map((title) => {
    let base = slugRawFromTitle(title, 'artwork');
    let id = base;
    let n = 2;
    while (used.has(id)) {
      id = `${base}-${n++}`;
    }
    used.add(id);
    return id;
  });
}

const artworkFragmentIds = uniqueArtworkFragmentIds(
  artworksRaw.map((a) => a.title),
  takenArtworkFragmentIds,
);

const isDev = import.meta.env.DEV;

const thumbnailPreloads = artworksRaw
  .map((artwork) =>
    typeof artwork.thumbnail === 'string'
      ? artwork.thumbnail
      : typeof artwork.image === 'string'
        ? artwork.image
        : null,
  )
  .filter((src): src is string => Boolean(src))
  .slice(0, 8);
---

<Layout title={`${site.siteTitle} — Paintings`} description={site.metaDescription}>
  <Fragment slot="head">
    {thumbnailPreloads.map((src) => (
      <link rel="preload" as="image" href={src} fetchpriority="high" />
    ))}
  </Fragment>

  <!-- Header -->
  <header class="header" id="top">
    <div class="container header-inner">
      <a href="#top" class="header-name">{site.siteTitle}</a>
      <div class="header-actions">
        <nav class="header-nav">
          <a href="#about">About</a>
          <a href="#works">Works</a>
        </nav>
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="Switch theme"
          aria-pressed="false"
        >
          <svg
            class="theme-toggle-icon theme-toggle-moon"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg
            class="theme-toggle-icon theme-toggle-sun"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    <!-- About -->
    <section class="about" id="about">
      <div class="container">
        <div class="about-content">
          {site.aboutParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <p class="about-contact">
            <span class="about-contact-name">{site.artistName}</span>
            <span class="about-contact-sep" aria-hidden="true">·</span>
            <a class="about-contact-email" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Gallery -->
    <section class="gallery" id="works">
      <div class="container">
        {artworksRaw.length === 0 && (
          <p class="gallery-empty">
            No artworks yet. Add entries to <code>src/data/artworks.json</code> and put each piece in its own
            folder under <code>public/artworks/</code> (see README).
          </p>
        )}

        {gallerySections.length > 0 && (
          <div class="gallery-layout">
            <div class="gallery-sections">
        {gallerySections.map((section, sectionIndex) => (
          <div class="gallery-section" id={gallerySectionFragmentIds[sectionIndex]}>
            <h3 class="gallery-section-heading">
              <span class="gallery-section-heading-title">{section.title}</span>
              <span class="gallery-section-count">
                {section.cards.length} {section.cards.length === 1 ? 'work' : 'works'}
              </span>
            </h3>
            <div
              class="gallery-wall"
              style={{
                '--grid-unit-max': `${GALLERY_DISPLAY_PX_PER_GRID_UNIT}px`,
                '--grid-row-extent': String(section.placed[0]?.rowExtent ?? 0),
                '--grid-col-extent': String(section.placed[0]?.colExtent ?? GALLERY_GRID_RESOLUTION),
              }}
            >
              {section.placed.map(({ artwork, index, x, y, w, h }) => {
                const thumb = artwork.thumbnail;
                const dateParts = getArtworkDateParts(artwork);
                const eagerThumb = index < 6;
                return (
                <button
                  type="button"
                  class:list={[
                    'artwork-card',
                    isCanvasPainting(artwork.materials) && 'artwork-card--canvas',
                    isDigitalArtwork(artwork.materials) && 'artwork-card--digital',
                    isCharcoalArtwork(artwork.materials) && 'artwork-card--charcoal',
                  ]}
                  id={artworkFragmentIds[index]}
                  data-index={index}
                  data-artwork-title={artwork.title}
                  aria-label={`View ${artwork.title}`}
                  style={{
                    '--ax': String(x),
                    '--ay': String(y),
                    '--aw': String(w),
                    '--ah': String(h),
                  }}
                >
                  <div class="artwork-image-wrap">
                    <img
                      src={thumb ?? artwork.image}
                      alt={artwork.title}
                      loading={eagerThumb ? 'eager' : 'lazy'}
                      decoding="async"
                      fetchpriority={eagerThumb ? 'high' : 'auto'}
                    />
                  </div>
                  <div class="artwork-caption">
                    <div class="artwork-caption-main">
                      <span class="artwork-card-title">{artwork.title}</span>
                      {dateParts && (
                        <span class="artwork-card-year">
                          {dateParts.month && (
                            <span class="artwork-card-year-month">{dateParts.month}</span>
                          )}
                          <span class="artwork-card-year-value">{dateParts.year}</span>
                        </span>
                      )}
                    </div>
                  </div>
                </button>
                );
              })}
            </div>
          </div>
        ))}
            </div>

            <nav class="works-index" aria-label="Gallery series">
              {gallerySections.map((section, sectionIndex) => (
                <a
                  class="works-index-bar"
                  href={`#${gallerySectionFragmentIds[sectionIndex]}`}
                  aria-label={section.title}
                  title={section.title}
                ></a>
              ))}
            </nav>
          </div>
        )}
      </div>
    </section>
  </main>

  {isDev && (
    <div id="gallery-layout-editor" class="gallery-layout-editor" hidden>
      <p class="gallery-layout-editor-label">Select a painting, then drag or use arrow keys</p>
      <div class="gallery-layout-editor-actions">
        <button type="button" id="gallery-layout-export">Copy JSON</button>
        <button type="button" id="gallery-layout-reset">Reset</button>
        <button type="button" id="gallery-layout-done">Done</button>
      </div>
    </div>
  )}

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-label="Artwork viewer">
    <button class="lightbox-close" aria-label="Close">&times;</button>

    <div class="lightbox-body">
      <button class="lightbox-nav lightbox-prev" aria-label="Previous artwork">&#8249;</button>

      <div class="lightbox-content">
        <div class="lightbox-image-area">
          <div class="lightbox-zoom-viewport" id="lb-zoom-viewport">
            <img
              id="lightbox-img"
              src=""
              alt=""
              tabindex="-1"
              title="Click to zoom in at that spot. When zoomed: drag to pan; click without dragging to zoom out."
            />
          </div>
        </div>

        <div class="lightbox-info">
          <h3 id="lb-title" class="lightbox-title"></h3>
          <p id="lb-description-wrap" class="lightbox-description-wrap">
            <span id="lb-description" class="lightbox-description"></span>
          </p>

          <dl class="lightbox-details">
            <div id="lb-date-wrap" class="detail-row">
              <dt>Date</dt>
              <dd id="lb-date"></dd>
            </div>
            <div id="lb-dimensions-wrap" class="detail-row">
              <dt>Dimensions</dt>
              <dd id="lb-dimensions"></dd>
            </div>
            <div class="detail-row">
              <dt>Materials</dt>
              <dd id="lb-materials"></dd>
            </div>
          </dl>

          <div id="lb-source-wrap" class="lightbox-source">
            <p id="lb-source-label" class="detail-label">Source picture</p>
            <div id="lb-source-images" class="lightbox-source-images"></div>
          </div>
        </div>
      </div>

      <button class="lightbox-nav lightbox-next" aria-label="Next artwork">&#8250;</button>
    </div>

    <!-- Mobile navigation -->
    <div class="lightbox-mobile-nav">
      <button type="button" class="lightbox-nav-mobile lightbox-prev-mobile" aria-label="Previous artwork">
        <span class="lightbox-nav-mobile-chevron" aria-hidden="true">&#8249;</span>
        <span class="lightbox-nav-mobile-label">Previous</span>
      </button>
      <button type="button" class="lightbox-nav-mobile lightbox-next-mobile" aria-label="Next artwork">
        <span class="lightbox-nav-mobile-label">Next</span>
        <span class="lightbox-nav-mobile-chevron" aria-hidden="true">&#8250;</span>
      </button>
    </div>
  </div>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      {isDev && (
        <div class="footer-layout-toggle">
          <button
            type="button"
            class="gallery-layout-toggle"
            id="gallery-layout-toggle"
            aria-label="Reorganize gallery layout"
            aria-pressed="false"
            title="Reorganize paintings on the grid"
          >
            Reorganize
          </button>
        </div>
      )}
      <p class="footer-line">&copy; {new Date().getFullYear()} {site.siteTitle}</p>
      <p class="footer-line">
        {site.artistName}
        <span class="footer-sep" aria-hidden="true"> · </span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </footer>
</Layout>

<script>
  import artworks from '../data/artworks.json';
  import { formatArtworkDate } from '../utils/formatArtworkDate';
  import { GALLERY_PACK_GAP } from '../constants/gallery';

  const THEME_KEY = 'theme';

  function syncThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    btn.setAttribute('aria-pressed', String(dark));
    btn.setAttribute(
      'aria-label',
      dark ? 'Switch to light theme' : 'Switch to dark theme',
    );
  }

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next =
      document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem(THEME_KEY, next);
    } catch {
      /* ignore */
    }
    syncThemeToggle();
  });

  syncThemeToggle();

  try {
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    mq.addEventListener('change', () => {
      if (localStorage.getItem(THEME_KEY)) return;
      document.documentElement.setAttribute('data-theme', mq.matches ? 'dark' : 'light');
      syncThemeToggle();
    });
  } catch {
    /* ignore */
  }

  const lightbox = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img');
  const lbTitle = document.getElementById('lb-title');
  const lbDescriptionWrap = document.getElementById('lb-description-wrap');
  const lbDescription = document.getElementById('lb-description');
  const lbDate = document.getElementById('lb-date');
  const lbDateWrap = document.getElementById('lb-date-wrap');
  const lbDimensionsWrap = document.getElementById('lb-dimensions-wrap');
  const lbDimensions = document.getElementById('lb-dimensions');
  const lbMaterials = document.getElementById('lb-materials');
  const lbSourceWrap = document.getElementById('lb-source-wrap');
  const lbSourceLabel = document.getElementById('lb-source-label');
  const lbSourceImages = document.getElementById('lb-source-images');
  const lbZoomViewport = document.getElementById('lb-zoom-viewport');

  let current = 0;
  let lbImageRequest = 0;

  const fullImagePreloadState = new Map();

  const LB_PAN_CLICK_THRESHOLD = 8;
  /** Zoomed width ≈ this × fitted width, capped at native resolution (lower = less zoom). */
  const LB_ZOOM_OVER_FIT = 2;

  let lbPanDragging = false;
  let lbPanLastX = 0;
  let lbPanLastY = 0;
  let lbPanDragDistance = 0;
  let lbPanSuppressClick = false;

  function teardownLbPanListeners() {
    document.removeEventListener('mousemove', onLbPanMove);
    document.removeEventListener('mouseup', onLbPanEnd);
  }

  function onLbPanMove(e) {
    if (!lbPanDragging) return;
    const dx = e.clientX - lbPanLastX;
    const dy = e.clientY - lbPanLastY;
    lbPanLastX = e.clientX;
    lbPanLastY = e.clientY;
    lbPanDragDistance += Math.abs(dx) + Math.abs(dy);
    lbZoomViewport.scrollLeft -= dx;
    lbZoomViewport.scrollTop -= dy;
  }

  function onLbPanEnd() {
    if (!lbPanDragging) return;
    lbPanDragging = false;
    lbZoomViewport.classList.remove('is-panning');
    document.body.style.userSelect = '';
    teardownLbPanListeners();
    if (lbPanDragDistance >= LB_PAN_CLICK_THRESHOLD) {
      lbPanSuppressClick = true;
    }
    lbPanDragDistance = 0;
  }

  function onLbPanStart(e) {
    if (!lbZoomViewport.classList.contains('is-zoomed')) return;
    if (e.button !== 0) return;
    e.preventDefault();
    lbPanDragging = true;
    lbPanDragDistance = 0;
    lbPanLastX = e.clientX;
    lbPanLastY = e.clientY;
    lbZoomViewport.classList.add('is-panning');
    document.body.style.userSelect = 'none';
    document.addEventListener('mousemove', onLbPanMove);
    document.addEventListener('mouseup', onLbPanEnd);
  }

  function resetLightboxZoom() {
    teardownLbPanListeners();
    lbPanDragging = false;
    lbZoomViewport.classList.remove('is-panning');
    document.body.style.userSelect = '';
    lbPanDragDistance = 0;
    lbPanSuppressClick = false;
    lbZoomViewport.classList.remove('is-zoomed');
    lbImg.style.width = '';
    lbImg.style.height = '';
    lbImg.style.maxWidth = '';
    lbImg.style.maxHeight = '';
    lbZoomViewport.scrollLeft = 0;
    lbZoomViewport.scrollTop = 0;
  }

  /**
   * Zoom in so the image pixel under the pointer stays under the pointer (object-fit: contain math).
   * Keyboard zoom uses the image center. Double rAF waits for layout after size change.
   */
  function toggleLightboxZoom(e) {
    if (!lbImg.complete || lbImg.naturalWidth < 2) return;
    if (lbZoomViewport.classList.contains('is-zoomed')) {
      resetLightboxZoom();
      lbImg.title = 'Click to zoom in at that spot. When zoomed: drag to pan; click without dragging to zoom out.';
      return;
    }

    const nw = lbImg.naturalWidth;
    const nh = lbImg.naturalHeight;
    const imgRect = lbImg.getBoundingClientRect();

    let clientX;
    let clientY;
    if (e && 'clientX' in e && typeof e.clientX === 'number') {
      clientX = e.clientX;
      clientY = e.clientY;
    } else {
      clientX = imgRect.left + imgRect.width / 2;
      clientY = imgRect.top + imgRect.height / 2;
    }

    const scale = Math.min(imgRect.width / nw, imgRect.height / nh);
    const safeScale = Number.isFinite(scale) && scale > 0 ? scale : 1;
    const dispW = nw * safeScale;
    const dispH = nh * safeScale;
    const padX = (imgRect.width - dispW) / 2;
    const padY = (imgRect.height - dispH) / 2;
    let ix = (clientX - imgRect.left - padX) / safeScale;
    let iy = (clientY - imgRect.top - padY) / safeScale;
    ix = Math.min(nw, Math.max(0, ix));
    iy = Math.min(nh, Math.max(0, iy));

    const zoomW = Math.min(nw, dispW * LB_ZOOM_OVER_FIT);
    const zoomH = (zoomW / nw) * nh;

    lbImg.style.maxWidth = 'none';
    lbImg.style.maxHeight = 'none';
    lbImg.style.width = `${zoomW}px`;
    lbImg.style.height = 'auto';
    lbZoomViewport.classList.add('is-zoomed');
    lbImg.title = 'Drag to pan; click without dragging to zoom out';

    const applyScroll = () => {
      const vp = lbZoomViewport.getBoundingClientRect();
      const contentX = (ix / nw) * zoomW;
      const contentY = (iy / nh) * zoomH;
      const sl = contentX - (clientX - vp.left);
      const st = contentY - (clientY - vp.top);
      const maxL = Math.max(0, lbZoomViewport.scrollWidth - lbZoomViewport.clientWidth);
      const maxT = Math.max(0, lbZoomViewport.scrollHeight - lbZoomViewport.clientHeight);
      lbZoomViewport.scrollLeft = Math.min(maxL, Math.max(0, sl));
      lbZoomViewport.scrollTop = Math.min(maxT, Math.max(0, st));
    };

    requestAnimationFrame(() => {
      requestAnimationFrame(applyScroll);
    });
  }

  function decodeHashId() {
    const raw = location.hash.slice(1);
    if (!raw) return '';
    try {
      return decodeURIComponent(raw);
    } catch {
      return raw;
    }
  }

  /** After closing the lightbox, drop #hash only when it pointed at an artwork card. */
  function stripArtworkHashIfPresent() {
    const id = decodeHashId();
    if (!id || !history.replaceState) return;
    const el = document.getElementById(id);
    if (el?.classList.contains('artwork-card')) {
      history.replaceState(null, '', location.pathname + location.search);
    }
  }

  function getSourceUrls(a) {
    if (Array.isArray(a.sources) && a.sources.length > 0) {
      return a.sources.filter(Boolean);
    }
    if (a.source) return [a.source];
    return [];
  }

  /** Digital works use pixel→cm only for wall scale; omit dimensions in the viewer. */
  function isDigitalMaterials(materials) {
    return typeof materials === 'string' && materials.trim().toLowerCase() === 'digital';
  }

  function closeLightboxVisual() {
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    lbImg.tabIndex = -1;
    resetLightboxZoom();
  }

  function open(index) {
    current = index;
    update();
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    lbImg.tabIndex = 0;
  }

  function close() {
    closeLightboxVisual();
    stripArtworkHashIfPresent();
  }

  function getFullImageUrls() {
    const seen = new Set();
    const urls = [];
    for (const artwork of artworks) {
      if (typeof artwork.image !== 'string' || !artwork.image || seen.has(artwork.image)) {
        continue;
      }
      seen.add(artwork.image);
      urls.push(artwork.image);
    }
    return urls;
  }

  function preloadFullImage(src) {
    const status = fullImagePreloadState.get(src);
    if (status === 'done' || status === 'error') return Promise.resolve();
    if (status === 'pending') {
      return new Promise((resolve) => {
        const wait = () => {
          const next = fullImagePreloadState.get(src);
          if (next === 'done' || next === 'error') resolve();
          else setTimeout(wait, 40);
        };
        wait();
      });
    }

    fullImagePreloadState.set(src, 'pending');
    return new Promise((resolve) => {
      const img = new Image();
      const finish = () => {
        fullImagePreloadState.set(
          src,
          img.complete && img.naturalWidth > 0 ? 'done' : 'error',
        );
        resolve();
      };
      img.onload = finish;
      img.onerror = finish;
      img.src = src;
      if (img.complete) finish();
    });
  }

  function scheduleIdleTask(task) {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => task(), { timeout: 5000 });
    } else {
      setTimeout(task, 150);
    }
  }

  function shouldSkipBackgroundPreload() {
    try {
      const conn = navigator.connection;
      if (conn?.saveData) return true;
      if (conn?.effectiveType === 'slow-2g' || conn?.effectiveType === '2g') return true;
    } catch {
      /* ignore */
    }
    return false;
  }

  async function preloadFullImagesInBackground() {
    if (shouldSkipBackgroundPreload()) return;

    for (const url of getFullImageUrls()) {
      await new Promise((resolve) => {
        scheduleIdleTask(() => {
          preloadFullImage(url).then(resolve);
        });
      });
    }
  }

  function startFullImagePreloadAfterReveal() {
    const run = () => {
      preloadFullImagesInBackground();
    };

    if (document.documentElement.classList.contains('is-ready')) {
      run();
      return;
    }

    const observer = new MutationObserver(() => {
      if (!document.documentElement.classList.contains('is-ready')) return;
      observer.disconnect();
      run();
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }

  function setLightboxImage(src, alt) {
    const requestId = ++lbImageRequest;
    lbImg.classList.add('is-loading');

    const reveal = () => {
      if (requestId !== lbImageRequest) return;
      lbImg.classList.remove('is-loading');
    };

    if (!src) {
      lbImg.removeAttribute('src');
      lbImg.alt = alt;
      reveal();
      return;
    }

    const applyImage = () => {
      if (requestId !== lbImageRequest) return;
      lbImg.src = src;
      lbImg.alt = alt;
      const decoded = lbImg.decode?.().catch(() => {}) ?? Promise.resolve();
      decoded.then(reveal);
    };

    const loader = new Image();
    loader.onload = applyImage;
    loader.onerror = applyImage;
    loader.src = src;
    if (loader.complete) applyImage();
  }

  function update() {
    resetLightboxZoom();
    lbImg.title = 'Click to zoom in at that spot. When zoomed: drag to pan; click without dragging to zoom out.';
    const a = artworks[current];
    setLightboxImage(a.image, a.title);
    lbTitle.textContent = a.title;
    const description =
      a.description != null ? String(a.description).trim() : '';
    if (description !== '') {
      lbDescriptionWrap.style.display = '';
      lbDescription.textContent = description;
    } else {
      lbDescriptionWrap.style.display = 'none';
      lbDescription.textContent = '';
    }
    const dateStr = formatArtworkDate(a);
    lbDate.textContent = dateStr;
    lbDateWrap.style.display = dateStr.trim() !== '' ? '' : 'none';
    const hasDims =
      !isDigitalMaterials(a.materials) &&
      a.dimensions != null &&
      String(a.dimensions).trim() !== '';
    lbDimensionsWrap.style.display = hasDims ? '' : 'none';
    lbDimensions.textContent = hasDims ? String(a.dimensions) : '';
    lbMaterials.textContent = a.materials;

    const sourceUrls = getSourceUrls(a);
    if (sourceUrls.length > 0) {
      lbSourceWrap.style.display = '';
      lbSourceLabel.textContent =
        sourceUrls.length > 1 ? 'Source pictures' : 'Source picture';
      lbSourceImages.replaceChildren();
      sourceUrls.forEach((url, i) => {
        const img = document.createElement('img');
        img.className = 'lightbox-source-thumb';
        img.src = url;
        img.alt = `Source reference ${i + 1} for ${a.title}`;
        img.loading = 'lazy';
        img.decoding = 'async';
        lbSourceImages.appendChild(img);
      });
    } else {
      lbSourceWrap.style.display = 'none';
      lbSourceImages.replaceChildren();
    }

    if (lightbox.getAttribute('aria-hidden') === 'false' && history.replaceState) {
      const card = document.querySelector(`.artwork-card[data-index="${current}"]`);
      if (card?.id) {
        history.replaceState(null, '', `#${card.id}`);
      }
    }
  }

  function go(dir) {
    current = (current + dir + artworks.length) % artworks.length;
    update();
  }

  function applyLocationHash() {
    const id = decodeHashId();
    if (!id) {
      if (lightbox.getAttribute('aria-hidden') === 'false') {
        closeLightboxVisual();
      }
      return;
    }
    const el = document.getElementById(id);
    if (!el) return;
    if (el.classList.contains('artwork-card')) {
      const idx = parseInt(el.dataset.index, 10);
      if (!Number.isNaN(idx)) open(idx);
      return;
    }
    if (lightbox.getAttribute('aria-hidden') === 'false') {
      closeLightboxVisual();
    }
    el.scrollIntoView({ block: 'start', behavior: 'smooth' });
  }

  lbZoomViewport.addEventListener('mousedown', onLbPanStart);

  lbImg.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lbZoomViewport.classList.contains('is-zoomed') && lbPanSuppressClick) {
      lbPanSuppressClick = false;
      return;
    }
    toggleLightboxZoom(e);
  });

  lbImg.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      toggleLightboxZoom();
    }
  });

  let layoutSuppressClick = false;

  if (import.meta.env.DEV) {
    const LAYOUT_SAVE_URL = '/api/gallery-layout.json';
    const LAYOUT_DRAG_SNAP = 0.5;

    const layoutEditor = document.getElementById('gallery-layout-editor');
    const layoutToggle = document.getElementById('gallery-layout-toggle');
    const layoutExportBtn = document.getElementById('gallery-layout-export');
    const layoutResetBtn = document.getElementById('gallery-layout-reset');
    const layoutDoneBtn = document.getElementById('gallery-layout-done');

    let layoutEditMode = false;
    let layoutSelectedCard = null;
    let layoutDragCard = null;
    let layoutDragWall = null;
    let layoutDragStartX = 0;
    let layoutDragStartY = 0;
    let layoutDragOriginAx = 0;
    let layoutDragOriginAy = 0;
    let layoutDragMoved = false;

    function parseCssUnit(value) {
      const n = parseFloat(value);
      return Number.isFinite(n) ? n : 0;
    }

    function cardGridPos(card) {
      const inline = card.style;
      const computed = getComputedStyle(card);
      const read = (name) =>
        parseCssUnit(inline.getPropertyValue(name)) ||
        parseCssUnit(computed.getPropertyValue(name));
      return {
        ax: read('--ax'),
        ay: read('--ay'),
        aw: read('--aw'),
        ah: read('--ah'),
      };
    }

    function wallGridUnit(wall) {
      return parseCssUnit(getComputedStyle(wall).getPropertyValue('--grid-unit')) || 10;
    }

    function snapLayout(n, step) {
      return Math.round(n / step) * step;
    }

    function rectsOverlapWithGap(a, b, gap) {
      return (
        a.ax < b.ax + b.aw + gap &&
        a.ax + a.aw + gap > b.ax &&
        a.ay < b.ay + b.ah + gap &&
        a.ay + a.ah + gap > b.ay
      );
    }

    function canPlaceCardAt(card, ax, ay, wall) {
      const { aw, ah } = cardGridPos(card);
      const trial = { ax, ay, aw, ah };

      for (const other of wall.querySelectorAll('.artwork-card')) {
        if (other === card) continue;
        if (rectsOverlapWithGap(trial, cardGridPos(other), GALLERY_PACK_GAP)) return false;
      }

      return true;
    }

    function resizeGalleryWall(wall) {
      let maxRow = 0;
      let maxCol = 0;
      wall.querySelectorAll('.artwork-card').forEach((card) => {
        const { ax, ay, aw, ah } = cardGridPos(card);
        maxCol = Math.max(maxCol, ax + aw);
        maxRow = Math.max(maxRow, ay + ah);
      });
      wall.style.setProperty('--grid-row-extent', String(maxRow));
      wall.style.setProperty('--grid-col-extent', String(maxCol));
    }

    function setCardGridPos(card, ax, ay) {
      card.style.setProperty('--ax', String(ax));
      card.style.setProperty('--ay', String(ay));
      const wall = card.closest('.gallery-wall');
      if (wall) resizeGalleryWall(wall);
    }

    function collectLayoutPositions() {
      const positions = [];
      document.querySelectorAll('.artwork-card').forEach((card) => {
        const title = card.dataset.artworkTitle;
        if (!title) return;
        const { ax, ay } = cardGridPos(card);
        positions.push({ title, layout: { x: ax, y: ay } });
      });
      return positions;
    }

    function setLayoutSaveStatus(message, isError = false) {
      const label = document.querySelector('.gallery-layout-editor-label');
      if (!label) return;
      label.textContent = message;
      label.dataset.saveError = isError ? 'true' : 'false';
    }

    async function persistLayoutPositions(positions) {
      if (positions.length === 0) {
        throw new Error('No paintings found to save');
      }

      const response = await fetch(LAYOUT_SAVE_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ positions }),
      });

      if (!response.ok) {
        let detail = '';
        try {
          const data = await response.json();
          detail = data?.error ? `: ${data.error}` : '';
        } catch {
          /* ignore */
        }
        throw new Error(`Failed to save gallery layout${detail}`);
      }
    }

    function teardownLayoutDrag() {
      document.removeEventListener('mousemove', onLayoutDragMove);
      document.removeEventListener('mouseup', onLayoutDragEnd);
      document.removeEventListener('touchmove', onLayoutDragMove);
      document.removeEventListener('touchend', onLayoutDragEnd);
      document.body.style.userSelect = '';
    }

    function onLayoutDragMove(e) {
      if (!layoutDragCard || !layoutDragWall) return;
      const point = e.touches?.[0] ?? e;
      const unit = wallGridUnit(layoutDragWall);
      const step = e.shiftKey ? 1 : LAYOUT_DRAG_SNAP;
      const dx = (point.clientX - layoutDragStartX) / unit;
      const dy = (point.clientY - layoutDragStartY) / unit;

      if (Math.abs(dx) + Math.abs(dy) > 0.05) layoutDragMoved = true;

      const ax = Math.max(0, snapLayout(layoutDragOriginAx + dx, step));
      const ay = Math.max(0, snapLayout(layoutDragOriginAy + dy, step));

      if (canPlaceCardAt(layoutDragCard, ax, ay, layoutDragWall)) {
        setCardGridPos(layoutDragCard, ax, ay);
      }
    }

    function clearLayoutSelection() {
      layoutSelectedCard?.classList.remove('is-layout-selected');
      layoutSelectedCard = null;
    }

    function selectLayoutCard(card) {
      if (!card) return;
      if (layoutSelectedCard !== card) {
        layoutSelectedCard?.classList.remove('is-layout-selected');
        layoutSelectedCard = card;
        card.classList.add('is-layout-selected');
      }
      card.focus({ preventScroll: true });
    }

    function onLayoutDragEnd() {
      if (!layoutDragCard) return;
      const card = layoutDragCard;
      card.classList.remove('is-dragging');
      if (layoutDragMoved) {
        layoutSuppressClick = true;
        selectLayoutCard(card);
      } else {
        selectLayoutCard(card);
      }
      layoutDragCard = null;
      layoutDragWall = null;
      teardownLayoutDrag();
    }

    function onLayoutDragStart(e) {
      if (!layoutEditMode) return;
      const card = e.target.closest('.artwork-card');
      if (!card) return;

      const point = e.touches?.[0] ?? e;
      if (e.type === 'mousedown' && e.button !== 0) return;

      e.preventDefault();
      e.stopPropagation();

      layoutDragCard = card;
      layoutDragWall = card.closest('.gallery-wall');
      layoutDragStartX = point.clientX;
      layoutDragStartY = point.clientY;
      const pos = cardGridPos(card);
      layoutDragOriginAx = pos.ax;
      layoutDragOriginAy = pos.ay;
      layoutDragMoved = false;
      card.classList.add('is-dragging');

      document.body.style.userSelect = 'none';
      document.addEventListener('mousemove', onLayoutDragMove);
      document.addEventListener('mouseup', onLayoutDragEnd);
      document.addEventListener('touchmove', onLayoutDragMove, { passive: false });
      document.addEventListener('touchend', onLayoutDragEnd);
    }

    function moveLayoutCardByKeys(card, dx, dy, step) {
      const wall = card.closest('.gallery-wall');
      if (!wall) return false;

      const { ax, ay } = cardGridPos(card);
      const nextAx = Math.max(0, snapLayout(ax + dx, step));
      const nextAy = Math.max(0, snapLayout(ay + dy, step));

      if (!canPlaceCardAt(card, nextAx, nextAy, wall)) return false;
      setCardGridPos(card, nextAx, nextAy);
      return true;
    }

    function onLayoutCardSelect(e) {
      if (!layoutEditMode) return;
      if (layoutSuppressClick) {
        layoutSuppressClick = false;
        return;
      }
      e.preventDefault();
      e.stopPropagation();
      selectLayoutCard(e.currentTarget);
    }

    function onLayoutKeyDown(e) {
      if (!layoutEditMode || !layoutSelectedCard) return;

      const step = e.shiftKey ? 1 : LAYOUT_DRAG_SNAP;
      let dx = 0;
      let dy = 0;

      if (e.key === 'ArrowLeft') dx = -step;
      else if (e.key === 'ArrowRight') dx = step;
      else if (e.key === 'ArrowUp') dy = -step;
      else if (e.key === 'ArrowDown') dy = step;
      else return;

      e.preventDefault();
      e.stopPropagation();
      moveLayoutCardByKeys(layoutSelectedCard, dx, dy, step);
    }

    function setLayoutEditMode(on) {
      layoutEditMode = on;
      document.body.classList.toggle('gallery-layout-edit-mode', on);
      if (layoutEditor) layoutEditor.hidden = !on;
      if (layoutToggle) layoutToggle.setAttribute('aria-pressed', String(on));
      if (!on) {
        clearLayoutSelection();
        document.activeElement?.closest?.('.artwork-card')?.blur();
      }
    }

    function exportLayoutJson() {
      const entries = [];
      document.querySelectorAll('.artwork-card').forEach((card) => {
        const { ax, ay } = cardGridPos(card);
        entries.push({
          title: card.dataset.artworkTitle,
          layout: { x: ax, y: ay },
        });
      });
      const text = JSON.stringify(entries, null, 2);
      navigator.clipboard?.writeText(text).catch(() => {});
      if (layoutExportBtn) layoutExportBtn.textContent = 'Copied!';
      window.setTimeout(() => {
        if (layoutExportBtn) layoutExportBtn.textContent = 'Copy JSON';
      }, 1600);
    }

    async function resetLayoutPositions() {
      setLayoutSaveStatus('Running auto layout…');
      const response = await fetch(LAYOUT_SAVE_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reset: true }),
      });
      if (!response.ok) {
        setLayoutSaveStatus('Reset failed — restart npm run dev', true);
        return;
      }
      location.reload();
    }

    layoutToggle?.addEventListener('click', () => {
      setLayoutEditMode(!layoutEditMode);
    });
    layoutDoneBtn?.addEventListener('click', () => {
      if (layoutDoneBtn) layoutDoneBtn.disabled = true;
      const positions = collectLayoutPositions();
      setLayoutSaveStatus('Saving…');
      persistLayoutPositions(positions)
        .then(() => {
          setLayoutEditMode(false);
          setLayoutSaveStatus('Saved');
          window.setTimeout(() => {
            setLayoutSaveStatus('Select a painting, then drag or use arrow keys');
          }, 1500);
        })
        .catch((error) => {
          setLayoutSaveStatus(
            error instanceof Error ? error.message : 'Save failed — restart npm run dev',
            true,
          );
        })
        .finally(() => {
          if (layoutDoneBtn) layoutDoneBtn.disabled = false;
        });
    });
    layoutResetBtn?.addEventListener('click', () => {
      resetLayoutPositions().catch(() => {});
    });
    layoutExportBtn?.addEventListener('click', exportLayoutJson);

    document.addEventListener('keydown', onLayoutKeyDown);

    document.querySelectorAll('.artwork-card').forEach((card) => {
      card.addEventListener('mousedown', onLayoutDragStart);
      card.addEventListener('touchstart', onLayoutDragStart, { passive: false });
      card.addEventListener('click', onLayoutCardSelect, true);
    });
  }

  document.querySelectorAll('.artwork-card').forEach((card) => {
    card.addEventListener('click', () => {
      if (import.meta.env.DEV) {
        if (layoutSuppressClick) {
          layoutSuppressClick = false;
          return;
        }
        if (document.body.classList.contains('gallery-layout-edit-mode')) return;
      }

      const idx = parseInt(card.dataset.index, 10);
      if (card.id && history.replaceState) {
        history.replaceState(null, '', `#${card.id}`);
      }
      open(idx);
    });
  });

  document.querySelector('.lightbox-close').addEventListener('click', close);
  document.querySelector('.lightbox-prev').addEventListener('click', () => go(-1));
  document.querySelector('.lightbox-next').addEventListener('click', () => go(1));
  document.querySelector('.lightbox-prev-mobile').addEventListener('click', () => go(-1));
  document.querySelector('.lightbox-next-mobile').addEventListener('click', () => go(1));

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) close();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox.getAttribute('aria-hidden') !== 'false') return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') go(-1);
    if (e.key === 'ArrowRight') go(1);
  });

  let touchStartX = 0;
  let touchSwipeAllowed = true;

  lightbox.addEventListener('touchstart', (e) => {
    if (e.touches.length !== 1) {
      touchSwipeAllowed = false;
      return;
    }
    touchStartX = e.touches[0].screenX;
    touchSwipeAllowed = !lbZoomViewport.classList.contains('is-zoomed');
  }, { passive: true });

  lightbox.addEventListener('touchmove', () => {
    if (lbZoomViewport.classList.contains('is-zoomed')) {
      touchSwipeAllowed = false;
    }
  }, { passive: true });

  lightbox.addEventListener('touchend', (e) => {
    if (!touchSwipeAllowed || lbZoomViewport.classList.contains('is-zoomed')) {
      touchSwipeAllowed = true;
      return;
    }
    const diff = e.changedTouches[0].screenX - touchStartX;
    if (Math.abs(diff) > 50) go(diff > 0 ? -1 : 1);
  });

  window.addEventListener('hashchange', applyLocationHash);
  applyLocationHash();

  function initWorksIndex() {
    const index = document.querySelector('.works-index');
    if (!index) return;

    const bars = [...index.querySelectorAll('.works-index-bar')];
    const sections = bars
      .map((bar) => {
        const id = bar.getAttribute('href')?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter((el) => el instanceof HTMLElement);

    if (!sections.length) return;

    const setActive = (id) => {
      bars.forEach((bar) => {
        const active = bar.getAttribute('href') === `#${id}`;
        bar.classList.toggle('is-active', active);
        if (active) bar.setAttribute('aria-current', 'location');
        else bar.removeAttribute('aria-current');
      });
    };

    const updateActiveFromScroll = () => {
      const bandTop = window.innerHeight * 0.2;
      const bandBottom = window.innerHeight * 0.8;
      const centerY = window.innerHeight * 0.5;
      const first = sections[0];
      const last = sections[sections.length - 1];

      // Below the gallery — keep the last section highlighted.
      if (last.getBoundingClientRect().bottom < bandTop) {
        setActive(last.id);
        return;
      }

      // Approaching the works — highlight the first section.
      if (first.getBoundingClientRect().top > bandBottom) {
        setActive(first.id);
        return;
      }

      // Active = section with the most overlap in the middle 60% of the viewport.
      let best = first;
      let bestOverlap = 0;
      for (const section of sections) {
        const { top, bottom } = section.getBoundingClientRect();
        const overlapTop = Math.max(top, bandTop);
        const overlapBottom = Math.min(bottom, bandBottom);
        const overlap = Math.max(0, overlapBottom - overlapTop);
        if (overlap > bestOverlap) {
          bestOverlap = overlap;
          best = section;
        }
      }

      if (bestOverlap > 0) {
        setActive(best.id);
        return;
      }

      // Between sections (gap in the band): nearest section center to window middle.
      let closest = first;
      let minDistance = Infinity;
      for (const section of sections) {
        const rect = section.getBoundingClientRect();
        const sectionCenter = (rect.top + rect.bottom) / 2;
        const distance = Math.abs(sectionCenter - centerY);
        if (distance < minDistance) {
          minDistance = distance;
          closest = section;
        }
      }
      setActive(closest.id);
    };

    let scrollScheduled = false;
    const scheduleScrollUpdate = () => {
      if (scrollScheduled) return;
      scrollScheduled = true;
      requestAnimationFrame(() => {
        scrollScheduled = false;
        updateActiveFromScroll();
      });
    };

    window.addEventListener('scroll', scheduleScrollUpdate, { passive: true });
    window.addEventListener('resize', scheduleScrollUpdate, { passive: true });

    const syncFromHash = () => {
      const hashId = decodeURIComponent(location.hash.replace(/^#/, ''));
      if (hashId && sections.some((section) => section.id === hashId)) {
        setActive(hashId);
        window.setTimeout(updateActiveFromScroll, 450);
        return;
      }
      updateActiveFromScroll();
    };

    syncFromHash();
    window.addEventListener('hashchange', syncFromHash);
    window.addEventListener('scrollend', updateActiveFromScroll, { passive: true });
  }

  initWorksIndex();
  startFullImagePreloadAfterReveal();
</script>

<style>
  /* ---- Layout ---- */
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 16px;
  }

  /* ---- Header ---- */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    height: var(--header-height);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .gallery-layout-toggle {
    font: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 6px 10px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }

  .gallery-layout-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .gallery-layout-toggle:focus-visible {
    outline: 2px solid var(--color-text-muted);
    outline-offset: 2px;
  }

  .gallery-layout-toggle[aria-pressed='true'] {
    color: var(--color-text);
    border-color: var(--color-text-muted);
    background: var(--color-surface);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-radius: 8px;
    color: var(--color-text-secondary);
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-text-muted);
    outline-offset: 2px;
  }

  .theme-toggle-icon {
    display: block;
  }

  .theme-toggle-sun {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-toggle-moon {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-toggle-sun {
    display: block;
  }

  .header-name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .header-nav {
    display: flex;
    gap: 32px;
  }

  .header-nav a {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }

  .header-nav a:hover {
    color: var(--color-text);
  }

  /* Hash links (#about, #works, #coal, #lamp, …): land below sticky header */
  #about,
  #works,
  .gallery-section[id],
  .artwork-card[id] {
    scroll-margin-top: calc(var(--header-height) + 16px);
  }

  /* ---- About ---- */
  .about {
    padding: 24px 0 28px;
  }

  .about-content {
    max-width: 520px;
    margin-inline: auto;
    text-align: center;
  }

  .about-content p {
    margin-bottom: 0.5rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .about-content > p:not(.about-contact) {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 250;
    line-height: 1.35;
    margin-bottom: 0.45rem;
  }

  .about-content p:last-child {
    margin-bottom: 0;
  }

  .about-contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 1.1rem;
    margin-bottom: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-text-secondary);
