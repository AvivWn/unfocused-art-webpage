---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Art portfolio' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var k = 'theme';
          var stored = localStorage.getItem(k);
          var dark =
            stored === 'dark' ||
            (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --max-width: 1100px;
    --header-height: 60px;
    --color-text: #1a1a1a;
    --color-text-secondary: #555;
    --color-text-muted: #888;
    --color-border: #e4e4e4;
    --color-bg: #ffffff;
    --color-surface: #f0f0ee;
    --color-header-bg: rgba(255, 255, 255, 0.92);
    --artwork-caption-fade: rgba(0, 0, 0, 0.65);
    --artwork-caption-text: #ffffff;
    --shadow-artwork: 0 2px 14px rgba(0, 0, 0, 0.07);
    --shadow-artwork-hover: 0 10px 28px rgba(0, 0, 0, 0.12);
    --shadow-artwork-canvas:
      -3px 4px 5px -1px rgba(0, 0, 0, 0.26), -6px 8px 12px -2px rgba(0, 0, 0, 0.22),
      -9px 12px 18px -4px rgba(0, 0, 0, 0.16);
    --shadow-artwork-canvas-hover:
      -4px 5px 7px -1px rgba(0, 0, 0, 0.3), -7px 10px 15px -2px rgba(0, 0, 0, 0.26),
      -11px 14px 22px -4px rgba(0, 0, 0, 0.19);
    --shadow-artwork-soft:
      0 2px 8px rgba(0, 0, 0, 0.1), 0 8px 20px rgba(0, 0, 0, 0.08),
      -2px 3px 10px rgba(0, 0, 0, 0.06);
    --shadow-artwork-soft-hover:
      0 6px 16px rgba(0, 0, 0, 0.12), 0 14px 32px rgba(0, 0, 0, 0.09),
      -3px 4px 14px rgba(0, 0, 0, 0.07);
  }

  html[data-theme='light'] {
    color-scheme: light;
  }

  html[data-theme='dark'] {
    color-scheme: dark;
    --color-text: #f0ece8;
    --color-text-secondary: #c4bdb4;
    --color-text-muted: #8a847c;
    --color-border: #45403a;
    --color-bg: #1f1d1b;
    --color-surface: #2c2926;
    --color-header-bg: rgba(31, 29, 27, 0.92);
    --artwork-caption-fade: rgba(0, 0, 0, 0.72);
    --artwork-caption-text: #f5f5f5;
    /* Stronger depth + hairline so cards read off the charcoal background */
    --shadow-artwork: 0 4px 20px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.07);
    --shadow-artwork-hover: 0 14px 40px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.1);
    --shadow-artwork-canvas:
      -4px 6px 14px -2px rgba(0, 0, 0, 0.55), -12px 16px 32px -8px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.06);
    --shadow-artwork-canvas-hover:
      -5px 8px 18px -2px rgba(0, 0, 0, 0.62), -14px 20px 38px -8px rgba(0, 0, 0, 0.48),
      0 0 0 1px rgba(255, 255, 255, 0.09);
    --shadow-artwork-soft:
      0 4px 16px rgba(0, 0, 0, 0.45), 0 10px 28px rgba(0, 0, 0, 0.32),
      0 0 0 1px rgba(255, 255, 255, 0.06);
    --shadow-artwork-soft-hover:
      0 8px 22px rgba(0, 0, 0, 0.5), 0 18px 40px rgba(0, 0, 0, 0.38),
      0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
      sans-serif;
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  img {
    max-width: 100%;
    display: block;
  }

  button {
    cursor: pointer;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
  }

  a {
    color: inherit;
    text-decoration: none;
  }
</style>
