  }

  .about-contact-email {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .about-contact-email:hover {
    color: var(--color-text);
  }

  /* ---- Gallery ---- */
  .gallery {
    padding: 28px 0 100px;
    border-top: 1px solid var(--color-border);
  }

  .gallery-empty {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .gallery-layout {
    position: relative;
    width: 100%;
  }

  .works-index {
    position: fixed;
    top: 50%;
    right: max(16px, calc((100vw - min(var(--max-width), 100vw - 32px)) / 2 + 16px));
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 28px;
    gap: 12px;
    padding-top: 4px;
    z-index: 2;
  }

  .works-index-bar {
    display: block;
    width: 100%;
    height: 3px;
    border-radius: 1px;
    background: var(--color-border);
    transition:
      background 0.2s ease,
      height 0.2s ease,
      opacity 0.2s ease;
  }

  .works-index-bar:hover {
    background: var(--color-text-muted);
  }

  .works-index-bar.is-active {
    height: 5px;
    background: var(--color-text);
  }

  .works-index-bar:focus-visible {
    outline: 2px solid var(--color-text-muted);
    outline-offset: 4px;
  }

  .gallery-sections {
    width: 100%;
    min-width: 0;
  }

  .gallery-section + .gallery-section {
    margin-top: 72px;
  }

  .gallery-section-heading {
    display: grid;
    grid-template-columns: 3px 1fr;
    column-gap: 0.85rem;
    align-items: start;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--color-text-secondary);
    margin-bottom: 28px;
    line-height: 1.3;
    text-align: left;
  }

  .gallery-section-heading::before {
    content: '';
    grid-column: 1;
    grid-row: 1 / -1;
    width: 3px;
    border-radius: 1px;
    background: var(--color-text-muted);
    align-self: stretch;
  }

  .gallery-section-heading-title {
    grid-column: 2;
    grid-row: 1;
    display: block;
    color: var(--color-text);
  }

  .gallery-section-count {
    grid-column: 2;
    grid-row: 2;
    display: block;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    color: var(--color-text-muted);
  }

  /*
   * 100×100 cm virtual wall (1 unit = 1 cm). Each unit renders at --grid-unit-max px
   * on large screens; shrinks on narrow viewports so the wall still fits.
   */
  .gallery-wall {
    --grid-unit: min(
      var(--grid-unit-max, 10px),
      calc(94vw / var(--grid-col-extent, 100))
    );
    --wall-width: calc(var(--grid-col-extent, 100) * var(--grid-unit));
    position: relative;
    width: var(--wall-width);
    height: max(0px, calc(var(--grid-row-extent) * var(--grid-unit)));
    max-width: 100%;
    margin-inline: auto;
    padding: 6px 0 26px;
  }

  .artwork-card {
    container-type: inline-size;
    position: absolute;
    z-index: 0;
    overflow: hidden;
    left: calc(var(--ax) * var(--grid-unit));
    top: calc(var(--ay) * var(--grid-unit));
    width: calc(var(--aw) * var(--grid-unit));
    height: calc(var(--ah) * var(--grid-unit));
    --card-w: calc(var(--aw) * var(--grid-unit));
    --card-h: calc(var(--ah) * var(--grid-unit));
    /* Scale with tile width; small tiles get smaller type via lower min + ratio */
    --caption-size: min(0.9375rem, max(0.625rem, calc(var(--card-w) * 0.039)));
    --caption-inset: max(0.55rem, calc(var(--caption-size) * 0.72), calc(var(--card-w) * 0.045));
    background: var(--color-bg);
    text-align: left;
    border: none;
    padding: 0;
    cursor: pointer;
    border-radius: 5px;
    box-shadow: var(--shadow-artwork);
    isolation: isolate;
    transition: box-shadow 0.2s ease;
  }

  .artwork-card:hover {
    z-index: 2;
    box-shadow: var(--shadow-artwork-hover);
  }

  :global(body.gallery-layout-edit-mode) .artwork-card {
    cursor: grab;
    touch-action: none;
  }

  :global(body.gallery-layout-edit-mode) .artwork-card.is-dragging {
    cursor: grabbing;
    z-index: 5;
    outline: 2px dashed var(--color-text-muted);
    outline-offset: 3px;
    transform: none;
  }

  :global(body.gallery-layout-edit-mode) .artwork-card.is-layout-selected {
    z-index: 4;
    outline: 2px dashed var(--color-text);
    outline-offset: 3px;
    transform: none;
    box-shadow: var(--shadow-artwork-hover);
  }

  :global(body.gallery-layout-edit-mode) .artwork-card:hover {
    transform: none;
  }

  :global(body.gallery-layout-edit-mode) .artwork-card:hover .artwork-image-wrap img {
    transform: none;
  }

  .gallery-layout-editor {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 120;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 14px;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: var(--color-header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.12);
    max-width: min(94vw, 520px);
  }

  .gallery-layout-editor[hidden] {
    display: none;
  }

  .gallery-layout-editor-label {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin: 0;
    flex: 1 1 100%;
    text-align: center;
  }

  .gallery-layout-editor-label[data-save-error='true'] {
    color: #b42318;
  }

  .gallery-layout-editor-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .gallery-layout-editor-actions button {
    font: inherit;
    font-size: 0.85rem;
    padding: 7px 14px;
    border-radius: 7px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
  }

  .gallery-layout-editor-actions button:hover {
    border-color: var(--color-text-muted);
  }

  /* Light from upper-right: tight falloff, stays close to the canvas edge */
  .artwork-card--canvas {
    box-shadow: var(--shadow-artwork-canvas);
  }

  .artwork-card--canvas:hover {
    box-shadow: var(--shadow-artwork-canvas-hover);
  }

  /* Digital & charcoal: softer ambient lift than canvas (no stretched fabric edge) */
  .artwork-card--digital,
  .artwork-card--charcoal {
    box-shadow: var(--shadow-artwork-soft);
  }

  .artwork-card--digital:hover,
  .artwork-card--charcoal:hover {
    box-shadow: var(--shadow-artwork-soft-hover);
  }

  .artwork-image-wrap {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
  }

  .artwork-image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 0;
    transition: transform 0.22s ease;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  .artwork-card:hover .artwork-image-wrap img {
    transform: scale(1.03) translateZ(0);
  }

  :global(html[data-theme='dark']) .artwork-card:hover .artwork-image-wrap img {
    transform: none;
  }

  :global(html[data-theme='dark']) .artwork-caption {
    transition: none;
  }

  .artwork-caption {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    padding: var(--caption-inset);
    gap: max(calc(var(--caption-size) * 0.65), calc(var(--card-w) * 0.035));
    color: var(--artwork-caption-text);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.22s ease;
  }

  .artwork-caption::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.08) 38%,
      var(--artwork-caption-fade) 72%,
      var(--artwork-caption-fade-end, var(--artwork-caption-fade)) 100%
    );
    opacity: 0;
    transition: opacity 0.22s ease;
    pointer-events: none;
  }

  .artwork-caption-main {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: max(calc(var(--caption-size) * 1.25), calc(var(--card-w) * 0.07));
    width: 100%;
    min-width: 0;
  }

  .artwork-card:hover .artwork-caption {
    opacity: 1;
    visibility: visible;
  }

  .artwork-card:hover .artwork-caption::before {
    opacity: 1;
  }

  :global(html[data-theme='dark']) .artwork-caption::before {
    transition: none;
  }

  :global(html[data-theme='dark']) .artwork-card:hover .artwork-caption {
    transition: none;
  }

  /* Touch devices: no hover — keep titles visible on gallery tiles */
  @media (hover: none), (pointer: coarse) {
    .artwork-caption {
      opacity: 1;
      visibility: visible;
    }

    .artwork-caption::before {
      opacity: 1;
    }

    .artwork-card:hover .artwork-image-wrap img {
      transform: none;
    }
  }

  .artwork-card-title {
    font-size: var(--caption-size);
    font-weight: 500;
    line-height: 1.25;
    min-width: 0;
    flex: 1 1 0;
    padding-right: max(calc(var(--caption-size) * 1.5), calc(var(--card-w) * 0.05));
    overflow-wrap: normal;
    word-break: normal;
  }

  .artwork-card-year {
    font-size: calc(var(--caption-size) * 0.88);
    opacity: 0.8;
    flex: 0 0 auto;
    min-width: 0;
    max-width: 46%;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-content: flex-end;
    align-items: flex-end;
    column-gap: 0.25em;
    text-align: right;
    line-height: 1.25;
  }

  .artwork-card-year-month,
  .artwork-card-year-value {
    white-space: nowrap;
  }

  /* Small tiles (e.g. Perfectionism): stack date to free width and separate from title */
  @container (max-width: 12rem) {
    .artwork-card-year:has(.artwork-card-year-month) {
      flex-direction: column;
      align-items: flex-end;
      flex-wrap: nowrap;
    }
  }

  /* ---- Lightbox ---- */
  .lightbox {
    position: fixed;
    inset: 0;
    height: 100dvh;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.94);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .lightbox[aria-hidden='false'] {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 20px;
    font-size: 2.2rem;
    color: #fff;
    z-index: 10;
    opacity: 0.6;
    transition: opacity 0.2s;
    line-height: 1;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  .lightbox-body {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: var(--max-width);
    flex: 1;
    padding: 60px 12px 20px;
    min-height: 0;
  }

  .lightbox-nav {
    flex-shrink: 0;
    font-size: 2.8rem;
    color: #fff;
    opacity: 0.4;
    transition: opacity 0.2s;
    padding: 16px;
    line-height: 1;
  }

  .lightbox-nav:hover {
    opacity: 1;
  }

  .lightbox-content {
    flex: 1;
    display: flex;
    gap: 40px;
    align-items: center;
    min-height: 0;
    min-width: 0;
    overflow-y: auto;
  }

  .lightbox-image-area {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
  }

  .lightbox-zoom-viewport {
    flex: 1;
    width: 100%;
    min-width: 0;
    min-height: 0;
    max-height: 78vh;
    overflow: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
    border-radius: 2px;
  }

  .lightbox-zoom-viewport:not(.is-zoomed) {
    cursor: zoom-in;
  }

  .lightbox-zoom-viewport.is-zoomed {
    cursor: grab;
    align-items: flex-start;
    justify-content: flex-start;
    user-select: none;
  }

  .lightbox-zoom-viewport.is-zoomed.is-panning {
    cursor: grabbing;
  }

  .lightbox-zoom-viewport img {
    display: block;
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    object-fit: contain;
    margin: auto;
    border-radius: 2px;
    outline: none;
    transition: opacity 0.15s ease;
  }

  .lightbox-zoom-viewport img.is-loading {
    opacity: 0;
  }

  .lightbox-zoom-viewport.is-zoomed img {
    margin: 0;
    max-width: none;
    max-height: none;
    cursor: grab;
    pointer-events: auto;
  }

  .lightbox-zoom-viewport.is-zoomed.is-panning img {
    cursor: grabbing;
  }

  .lightbox-info {
    flex-shrink: 0;
    width: 220px;
    color: #fff;
    font-family: var(--font-body, 'DM Sans', system-ui, sans-serif);
  }

  .lightbox-title {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 28px;
    line-height: 1.35;
  }

  .lightbox-description-wrap {
    margin: -16px 0 24px;
  }

  .lightbox-description {
    display: block;
    font-family: var(--font-display, 'DM Sans', system-ui, sans-serif);
    font-size: 0.98rem;
    font-weight: 250;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
  }

  .lightbox-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .detail-row dt,
  .detail-label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 3px;
  }

  .detail-row dd {
    font-size: 0.95rem;
  }

  .lightbox-source {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .lightbox-source-images {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 6px;
  }

  :global(.lightbox-source-images img) {
    display: block;
    max-width: 100%;
    max-height: 110px;
    object-fit: contain;
    border-radius: 3px;
  }

  .lightbox-mobile-nav {
    display: none;
  }

  /* ---- Footer ---- */
  .footer {
    padding: 36px 0;
    border-top: 1px solid var(--color-border);
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .footer-layout-toggle {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .footer-line {
    margin: 0;
  }

  .footer-line + .footer-line {
    margin-top: 0.4rem;
  }

  .footer a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer a:hover {
    color: var(--color-text-secondary);
  }

  /* ---- Responsive ---- */
  @media (min-width: 861px) {
    .artwork-card {
      --caption-size: min(1.125rem, max(0.75rem, calc(var(--card-w) * 0.048)));
    }
  }

  @media (max-width: 860px) {
    .gallery-layout {
      display: flex;
      flex-direction: column;
    }

    .works-index {
      display: none;
    }

    .artwork-caption {
      display: none;
    }

    .artwork-card:hover,
    .artwork-card:active {
      z-index: 0;
      box-shadow: var(--shadow-artwork);
    }

    .artwork-card:hover .artwork-image-wrap img,
    .artwork-card:active .artwork-image-wrap img {
      transform: none;
    }

    .artwork-card--canvas:hover,
    .artwork-card--canvas:active {
      box-shadow: var(--shadow-artwork-canvas);
    }

    .artwork-card--digital:hover,
    .artwork-card--digital:active,
    .artwork-card--charcoal:hover,
    .artwork-card--charcoal:active {
      box-shadow: var(--shadow-artwork-soft);
    }

    .lightbox {
      justify-content: flex-start;
    }

    .lightbox-body {
      flex: 1;
      min-height: 0;
      padding:
        calc(40px + env(safe-area-inset-top, 0px))
        10px
        0;
      align-items: stretch;
    }

    .lightbox-close {
      top: calc(6px + env(safe-area-inset-top, 0px));
      right: calc(6px + env(safe-area-inset-right, 0px));
      font-size: 2rem;
      padding: 8px 12px;
    }

    .lightbox-content {
      flex: 1;
      min-height: 0;
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      align-items: stretch;
      gap: 20px;
      overflow: hidden;
    }

    .lightbox-image-area {
      min-height: 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      overflow: hidden;
      padding: 0 6px 4px;
    }

    .lightbox-zoom-viewport {
      flex: 1 1 0;
      width: 100%;
      min-height: 0;
      max-height: none;
    }

    .lightbox-zoom-viewport:not(.is-zoomed) img {
      max-height: 100%;
      max-width: 100%;
    }

    .lightbox-info {
      width: 100%;
      max-width: none;
      margin: 0;
      flex: 0 0 auto;
      overflow: visible;
      padding: 4px 8px 12px;
    }

    .lightbox-title {
      display: block;
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 14px;
      line-height: 1.35;
    }

    .lightbox-description-wrap {
      margin: -6px 0 14px;
    }

    .lightbox-description {
      font-size: 0.92rem;
      line-height: 1.45;
      color: rgba(255, 255, 255, 0.72);
    }

    .lightbox-details {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px 16px;
    }

    .detail-row {
      min-width: 0;
    }

    .detail-row dt,
    .detail-label {
      font-size: 0.55rem;
      letter-spacing: 0.1em;
      margin-bottom: 4px;
    }

    .detail-row dd {
      font-size: 0.78rem;
      line-height: 1.35;
    }

    .lightbox-source {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 16px;
      padding-top: 16px;
    }

    .lightbox-source .detail-label {
      flex-shrink: 0;
      margin: 0;
      font-size: 0.55rem;
      white-space: nowrap;
    }

    .lightbox-source-images {
      flex: 0 1 auto;
      min-width: 0;
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 3px;
      margin-top: 0;
      align-items: center;
      justify-content: flex-start;
    }

    :global(.lightbox-source-images img) {
      flex: 0 0 auto;
      height: 88px;
      width: auto;
      max-width: 144px;
      max-height: 88px;
      object-fit: contain;
      border-radius: 2px;
      opacity: 0.9;
    }

    .lightbox-nav {
      display: none;
    }

    .lightbox-mobile-nav {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding:
        12px 16px
        calc(10px + env(safe-area-inset-bottom, 0px));
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .lightbox-nav-mobile {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      min-height: 44px;
      padding: 8px 6px;
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      color: rgba(255, 255, 255, 0.62);
      -webkit-tap-highlight-color: transparent;
      transition: color 0.2s ease;
    }

    .lightbox-prev-mobile {
      justify-content: flex-start;
      padding-left: 2px;
    }

    .lightbox-next-mobile {
      justify-content: flex-end;
      padding-right: 2px;
    }

    .lightbox-nav-mobile-chevron {
      font-size: 1.65rem;
      font-weight: 300;
      line-height: 1;
      transform: translateY(-1px);
    }

    .lightbox-nav-mobile-label {
      line-height: 1;
    }

    .lightbox-nav-mobile:active {
      color: #fff;
    }
  }

  @media (max-width: 640px) {
    .container {
      padding: 0 12px;
    }

    .header-nav {
      gap: 16px;
    }

    .header-actions {
      gap: 16px;
    }

    .header-nav a {
      font-size: 0.84rem;
    }

    .header-name {
      font-size: 1.25rem;
    }

    .theme-toggle {
      width: 38px;
      height: 38px;
    }

    .theme-toggle svg {
      width: 19px;
      height: 19px;
    }

    .about {
      padding: 16px 0 20px;
    }

    .about-content > p:not(.about-contact) {
      font-size: 1.05rem;
    }

    .about-contact {
      font-size: 0.88rem;
      margin-top: 0.9rem;
      padding-top: 0.85rem;
    }

    .gallery {
      padding: 24px 0 60px;
    }

    .gallery-section + .gallery-section {
      margin-top: 52px;
    }

    .gallery-section-heading {
      column-gap: 0.7rem;
      font-size: 1.15rem;
      margin-bottom: 20px;
    }

    .gallery-section-count {
      font-size: 0.75rem;
    }

    .gallery-wall {
      --grid-unit: min(
        var(--grid-unit-max, 10px),
        calc(90vw / var(--grid-col-extent, 100))
      );
      padding: 4px 0 16px;
    }

    .footer {
      padding: 28px 0;
      font-size: 0.72rem;
